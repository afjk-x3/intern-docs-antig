# Copy to .env.local and fill in real values. Per 12-backend-security-rules.md #10:
# this file lists every required variable name with no real values -- never commit
# actual secrets here or anywhere else in the repo.

# Supabase project (Settings -> API in the Supabase dashboard, or `supabase status`
# for the local stack)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Resend (email notifications, FR-18)
RESEND_API_KEY=
# Verified sending domain (PRD §14 NEEDS INPUT) or a full "Name <email@domain>" string.
# Falls back to onboarding@resend.dev (Resend's shared test sender) if unset.
RESEND_FROM_DOMAIN=

# Shared secret the scheduled-job routes (src/app/api/cron/*) authenticate incoming
# pg_cron/pg_net requests with -- see supabase/migrations/20240101000019_schedule_jobs.sql.
# Any random 32+ character string; must also be set via
# `ALTER DATABASE ... SET app.settings.cron_secret` on the Supabase project this app
# talks to.
CRON_SECRET=
